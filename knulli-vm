#!/bin/bash
# knulli-vm — manage a VM that runs apps inside the extracted KNULLI
# (TrimUI Brick et al.) userspace. See README.md.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
STATE="$HERE/state"

die() { echo "knulli-vm: $*" >&2; exit 1; }
has_quote() { case "$1" in *"'"*) return 0;; *) return 1;; esac; }
# enc — ship a path/command through an ssh command line without quoting
# hazards. App dirs keep the vendor's name ("grainbrick beta 1.0.1") and
# launch commands quote their own arguments; base64 is the only encoding
# whose output cannot be re-split or re-quoted on the way to the guest.
enc() { printf %s "$1" | base64 | tr -d '\n'; }

# ---- selection & config -----------------------------------------------------
VM=""
while [ $# -ge 1 ] && [ "$1" = "--vm" ]; do VM="$2"; shift 2; done
if [ -z "$VM" ]; then
    [ -f "$STATE/default" ] || die "no VM configured — run ./install.sh first (or pass --vm NAME)"
    VM=$(cat "$STATE/default")
fi
CONF="$STATE/$VM.conf"
[ -f "$CONF" ] || die "no config for VM '$VM' ($CONF) — re-run ./install.sh to regenerate it"
# Values may contain spaces — app dirs keep the vendor's own name, so
# DEFAULT_APP can be "grainbrick beta 1.0.1" and IMAGE a path with spaces.
# eval'ing `export K=V` split that into three words and died with
# "export: `1.0.1': not a valid identifier", leaving DEFAULT_APP half-set.
# Assign each pair as ONE argument instead.
while IFS='=' read -r kn vv; do
    [ -n "$kn" ] && export "$kn=$vv"
done < <(grep -E '^[A-Z_]+=' "$CONF")

# ---- how this CLI reaches the guest --------------------------------------------
# `limactl shell` is the documented way in, and it has one failure mode that must
# never be the tool's: it prepends `cd <whichever Mac folder you were in>` INSIDE
# the guest, over the virtiofs share, and that share can wedge — one FUSE request
# that never answers leaves every process touching it in D state (unkillable), and
# the mount then answers nothing even after a lazy umount and remount. Every
# knulli-vm command then hangs on that cd forever, including the ones that would
# have fixed it: the one tool that has to stay reachable cannot reach the VM. Raw
# ssh to the same guest — Lima's own ssh.config, same key, same port — never cd's
# into the share, so it answers anyway. ControlPath=none keeps every connection
# its own, so restarting one pipe cannot take the others down with it (that self
# inflicted silence has happened). `limactl shell` stays as the fallback for an
# install with no ssh.config.
GTRANSPORT=""
gtransport() {
    [ -n "$GTRANSPORT" ] && return
    if [ -f "$HOME/.lima/$VM/ssh.config" ]; then
        GTRANSPORT="ssh -F $HOME/.lima/$VM/ssh.config -o ControlPath=none -o BatchMode=yes -o ConnectTimeout=10 lima-$VM"
    else
        GTRANSPORT="limactl shell $VM --"
    fi
}
# printf %q because ssh joins its arguments with spaces and lets the GUEST shell
# re-split them: a command containing quotes has to arrive quoted for a shell that
# is not this one. (Same hazard enc() exists for.)
gexec() { gtransport; $GTRANSPORT bash -lc "$(printf '%q' "$1")"; }
appconf() { echo "$STATE/$VM.apps/$1"; }

default_app() {
    if [ -n "${DEFAULT_APP:-}" ] && [ -f "$(appconf "$DEFAULT_APP")" ]; then
        echo "$DEFAULT_APP"; return
    fi
    ls "$STATE/$VM.apps" 2>/dev/null | head -1
}

# ---- app registry -------------------------------------------------------------
detect_cmd() {  # $1 = app root dir (host path)
    local d="$1"
    if [ -f "$d/gb_launch.py" ]; then echo "/usr/bin/pygame gb_launch.py"
    elif [ -f "$d/main.py" ]; then echo "/usr/bin/pygame main.py"
    elif [ -f "$d/run.sh" ]; then echo "bash run.sh"
    elif [ "$(find "$d" -maxdepth 1 -name '*.sh' | wc -l | tr -d ' ')" = 1 ]; then
        echo "bash '$(basename "$(find "$d" -maxdepth 1 -name '*.sh')")'"
    else return 1; fi
}

cmd_app_add() {
    local src="" name="" cmd="" make_default=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --name) name="$2"; shift 2;;
            --cmd) cmd="$2"; shift 2;;
            --default) make_default=1; shift;;
            -*) die "unknown flag $1";;
            *) src="$1"; shift;;
        esac
    done
    [ -n "$src" ] || die "app add: need a source (zip/dir path or URL)"

    # fetch URLs
    case "$src" in
        http://*|https://*)
            mkdir -p "$HERE/downloads"
            local f="$HERE/downloads/$(basename "${src%%\?*}")"
            [ -f "$f" ] || { echo "downloading $src ..."; curl -fL --progress-bar -o "$f" "$src"; }
            src="$f";;
    esac
    [ -e "$src" ] || die "app source not found: $src"

    # unpack zips; find the app root. A single top-level directory wins even
    # when loose *.sh launcher companions sit next to it (GrainBrick's zip:
    # "GrainBrick beta 1.0.1.sh" + "grainbrick beta 1.0.1/") — those .sh files
    # are the launcher stubs KNULLI's EmulationStation runs on the device.
    #
    # Install the vendor's layout VERBATIM, name and all. Those stubs hardcode
    # their own app dir (GrainBrick 1.0.1's is APP='/userdata/roms/ports/
    # grainbrick beta 1.0.1') and the stub is what creates samples/, projects/
    # and recordings/ and seeds them from demo-samples/ and demo-projects/ on
    # first run. Renaming the directory to something shell-friendly — the old
    # `tr ' ' '-'` — pointed the stub at a path that does not exist, so we
    # skipped the stub and shipped users an empty sample browser the device
    # would never show them. Keep the name; carry it safely instead (DIR/CMD
    # reach the guest base64-encoded, so spaces cannot break the quoting).
    local root stub=""
    if [ -d "$src" ]; then root="$src"
    elif unzip -l "$src" >/dev/null 2>&1; then
        local u="$HERE/downloads/unpacked/$(basename "${src%.zip}")"
        [ -d "$u" ] || { mkdir -p "$u"; unzip -q "$src" -d "$u"; }
        local n nsh
        n=$(find "$u" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')
        nsh=$(find "$u" -mindepth 1 -maxdepth 1 -type f ! -name '*.sh' | wc -l | tr -d ' ')
        if [ "$n" = 1 ] && [ "$nsh" = 0 ]; then
            root=$(find "$u" -mindepth 1 -maxdepth 1 -type d)
            # the sibling stub a device would install next to the app dir
            stub=$(find "$u" -mindepth 1 -maxdepth 1 -type f -name '*.sh' | head -1)
        else root="$u"; fi
    else die "unsupported app source (want .zip or directory): $src"; fi

    [ -n "$name" ] || name=$(basename "$root")
    [ -n "$name" ] || die "could not derive an app name; pass --name"
    # spaces are fine (everything is quoted or encoded); a single quote is not,
    # because the chroot entry builds its command as a single-quoted string
    has_quote "$name" && die "app name '$name' contains a single quote — pass --name"
    has_quote "$stub" && die "launcher '$(basename "$stub")' has a single quote — pass --cmd"

    # Launch the way the device does: the vendor's own stub when the zip
    # shipped one, so its first-run setup runs. Only fall back to guessing an
    # entry point inside the app dir (which skips that setup).
    local cwd=""
    if [ -z "$cmd" ] && [ -n "$stub" ]; then
        cmd="sh './$(basename "$stub")'"; cwd="$ROOTFS/userdata/roms/ports"
    fi
    if [ -z "$cmd" ]; then
        cmd=$(detect_cmd "$root") || die "cannot auto-detect a launch script in $root (tried gb_launch.py, main.py, run.sh, one *.sh) — pass --cmd"
    fi

    local gdest="\$HOME/knulli-ports/$name"   # staging dir inside the guest
    local rdest="$ROOTFS/userdata/roms/ports/$name"
    local rports="$ROOTFS/userdata/roms/ports"
    echo "installing '$name' -> $rdest"
    # Upgrades preserve user data: apps like GrainBrick keep samples,
    # recordings, projects and settings INSIDE the app dir, and the app's
    # own README promises upgrades keep them. We stash those paths, install
    # the new version fresh, then lay the user's files back on top (user
    # wins; new-version defaults fill the gaps).
    #
    # Copy notes: $gdest carries a literal $HOME for the GUEST to expand, so
    # it stays outside single quotes — which means it MUST be double-quoted
    # here, since app dir names keep the vendor's spelling and can contain
    # spaces ("grainbrick beta 1.0.1"). Always copy CONTENTS with the /. form:
    # on Lima's virtiofs mount of the host home, `cp -a path/ dest/` (trailing
    # slash) wrongly copies the directory ITSELF into dest — that produced
    # maddening double-nested app dirs until diagnosed with a live probe.
    # Also: no backticks in comments inside this string — double quotes turn
    # them into command substitutions.
    gexec "
        set -e
        sudo rm -rf \"$gdest\" && mkdir -p \"$gdest\"
        cp -a '$root'/. \"$gdest/\"
        keep=()
        for p in samples recordings projects; do
            [ -d '$rdest/'\"\$p\" ] && keep+=(\"\$p\")
        done
        for f in '$rdest'/*.json; do
            [ -f \"\$f\" ] && keep+=(\"\$(basename \"\$f\")\")
        done
        stash=
        if [ \${#keep[@]} -gt 0 ]; then
            stash=\$(mktemp -d)
            for p in \${keep[@]}; do
                sudo mv '$rdest/'\"\$p\" \"\$stash/\"
            done
            echo \"  preserving: \${keep[*]}\"
        fi
        sudo rm -rf '$rdest'
        sudo mkdir -p '$rdest'
        sudo cp -a \"$gdest/.\" '$rdest/'
        if [ -n \"\$stash\" ]; then
            sudo cp -a \"\$stash/.\" '$rdest/'
            sudo rm -rf \"\$stash\"
        fi
        sudo rm -rf \"$gdest\"
    " || die "copy into rootfs failed"

    # the vendor's launcher stub goes NEXT TO the app dir, exactly where the
    # app's own install instructions (and its hardcoded APP= path) expect it
    local rstub=""
    if [ -n "$stub" ]; then
        rstub="$rports/$(basename "$stub")"
        echo "installing launcher stub -> $rstub"
        # staged through stdin (the deploy loop's proven pattern) — ssh joins
        # extra argv with spaces and the remote shell re-splits them, so a
        # path with spaces must never travel as an argument
        gexec "mkdir -p \$HOME/knulli-ports; install -m 644 /dev/stdin \$HOME/knulli-ports/.stub-sh" \
            < "$stub" || die "failed to stage the launcher stub"
        gexec "set -e; sudo install -m 755 \$HOME/knulli-ports/.stub-sh '$rstub'; \\
               rm -f \$HOME/knulli-ports/.stub-sh" \
            || die "failed to install the launcher stub"
    fi

    mkdir -p "$STATE/$VM.apps"
    {
        printf 'DIR=%s\nCMD=%s\n' "$rdest" "$cmd"
        [ -n "$cwd" ]  && printf 'CWD=%s\n'  "$cwd"
        [ -n "$rstub" ] && printf 'STUB=%s\n' "$rstub"
        :
    } > "$(appconf "$name")"
    if [ "$make_default" = 1 ] || [ -z "$(default_app)" ]; then
        grep -v '^DEFAULT_APP=' "$CONF" > "$CONF.tmp" || true
        echo "DEFAULT_APP=$name" >> "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
    fi
    echo "installed. launch with: knulli-vm start $name"
}

cmd_app_rm() {
    local name="${1:-}"; [ -n "$name" ] || die "app rm: need a name"
    [ -f "$(appconf "$name")" ] || die "no app '$name'"
    local conf="$(appconf "$name")"
    local rdest stub
    rdest=$(grep '^DIR=' "$conf" | cut -d= -f2-)
    stub=$(grep '^STUB=' "$conf" | cut -d= -f2-)
    gexec "sudo rm -rf '$rdest'${stub:+; sudo rm -f '$stub'}"
    rm -f "$conf"
    echo "removed $name"
}

cmd_app() {
    case "${1:-list}" in
        add) shift; cmd_app_add "$@";;
        rm|remove) shift; cmd_app_rm "$@";;
        default) [ -n "${2:-}" ] || die "app default: need a name"
            [ -f "$(appconf "$2")" ] || die "no app '$2'"
            grep -v '^DEFAULT_APP=' "$CONF" > "$CONF.tmp"; echo "DEFAULT_APP=$2" >> "$CONF.tmp"; mv "$CONF.tmp" "$CONF"
            echo "default app: $2";;
        list)
            local d; d=$(default_app)
            for f in "$STATE/$VM.apps"/*; do
                [ -e "$f" ] || { echo "(no apps installed)"; break; }
                local n; n=$(basename "$f")
                local tag=""; [ "$n" = "$d" ] && tag=" [default]"
                echo "  $n$tag  $(grep '^CMD=' "$f" | cut -d= -f2-)  <- $(grep '^DIR=' "$f" | cut -d= -f2-)"
            done;;
        *) die "app: add|rm|list|default";;
    esac
}

# ---- lifecycle ---------------------------------------------------------------
cmd_start() {
    local app="${1:-}"; app=${app:-$(default_app)}
    { [ -n "$app" ] && [ -f "$(appconf "$app")" ]; } || {
        cmd_app list; die "no app to start — install one: knulli-vm app add <zip|dir|url>"; }
    local conf dir cmd cwd
    conf="$(appconf "$app")"
    dir=$(grep '^DIR=' "$conf" | cut -d= -f2-)
    cmd=$(grep '^CMD=' "$conf" | cut -d= -f2-)
    # CWD is the dir the launcher runs from — the ports/ directory when the
    # app ships a launcher stub (that is where EmulationStation runs it),
    # otherwise the app dir itself
    cwd=$(grep '^CWD=' "$conf" | cut -d= -f2-); cwd="${cwd:-$dir}"
    # capture side first: if the app opens its ALSA stream before arecord
    # exists it underruns repeatedly and can end up ignoring input
    (cmd_audio start) || echo "  (audio could not start — retry: knulli-vm audio start)"
    gexec "test -f ~/knulli-vm/run_app.sh" \
        || die "guest launcher missing (~/knulli-vm/run_app.sh) — run: knulli-vm sync"
    echo "starting '$app' in the KNULLI userspace ($VM) ..."
    # Fully detached launch; stale pid/log cleared FIRST so what we read
    # below is from THIS run. On a second machine even `setsid nohup ... &`
    # was observed to die with limactl's ssh session without ever creating
    # the app log. A systemd *transient unit* is spawned by PID 1, so it
    # is outside the ssh session's reach entirely. Unique unit name so a
    # relaunch never collides with the previous exited unit; --collect
    # garbage-collects it when the app stops. HOME must be passed
    # explicitly: system units get no user environment.
    local unit="knulli-app-$(date +%s)"
    gexec "rm -f /tmp/knulli-app.pid ~/knulli-app.log \\
               || sudo rm -f /tmp/knulli-app.pid ~/knulli-app.log
           if command -v systemd-run >/dev/null; then
               # KillMode=process: the default (control-group) would kill
               # Xvnc/joypad/keymapd too — run_app.sh spawns them inside
               # this unit's cgroup, so an app crash would take the VNC
               # server down with it (observed: Xvnc exit report right
               # after startup, nothing left listening on 5901).
               # User=<guest user>: sudo systemd-run would run the unit as
               # ROOT, flipping the whole launcher's privilege model —
               # /tmp/knulli-app.pid becomes root-owned and later
               # start/stop (guest rm -f, sticky /tmp) can no longer clear
               # it, and a root Xvnc locks the guest user out of DISPLAY
               # :1 (screenshots die). run_app.sh sudo's internally where
               # it needs to; the unit itself must run as the lima user.
               sudo systemd-run --quiet --collect --unit='$unit' \\
                   --property=KillMode=process --property=User=\$(id -un) \\
                   --setenv=KNULLI_ROOT='$ROOTFS' --setenv=HOME=\$HOME \\
                   /bin/bash -c \"\$HOME/knulli-vm/run_app.sh b64:$(enc "$cwd") b64:$(enc "$cmd") '${VNC_PASS:-knulli}' '${VNC_PORT:-5901}' > \$HOME/knulli-app.log 2>&1\"
           else
               (KNULLI_ROOT='$ROOTFS' setsid nohup \$HOME/knulli-vm/run_app.sh b64:$(enc "$cwd") b64:$(enc "$cmd") '${VNC_PASS:-knulli}' '${VNC_PORT:-5901}' </dev/null > \$HOME/knulli-app.log 2>&1 &)
           fi" \
        || die "could not reach the guest to launch the app"
    # run_app.sh apt-installs xdotool/python3-xlib on a FIRST run (a
    # minute on a fresh VM) before it writes the pid file — the old
    # fixed `sleep 8` declared failure while it was still installing.
    # Poll instead; ps -p (not kill -0) so a later setuid-to-root of the
    # tracked pid doesn't read as "dead" via EPERM.
    local pid="" t=0
    while [ "$t" -lt 180 ]; do
        pid=$(gexec "cat /tmp/knulli-app.pid 2>/dev/null")
        if [ -n "$pid" ]; then
            gexec "ps -p '$pid' -o pid=" >/dev/null 2>&1 || break  # died after writing it; log holds the reason
            break
        fi
        sleep 3; t=$((t + 3))
        [ $((t % 15)) -eq 0 ] && echo "  waiting for the app ... ${t}s"
    done
    if [ -n "$pid" ] && gexec "ps -p '$pid' -o pid=" >/dev/null 2>&1; then
        echo "OK — $app running (guest pid $pid)"
    else
        echo "failed; app log:"
        gexec "tail -20 ~/knulli-app.log 2>/dev/null || {
            echo '(no app log at all: the launcher never ran)';
            ls -l ~/knulli-vm/run_app.sh 2>&1;
            echo 'try: knulli-vm sync, then knulli-vm start'; }"
        exit 1
    fi
    cmd_vnc | sed 's/^/  /'
    echo "  input: knulli-vm input 'hat down 150'   |   knulli-vm bridge (physical pad)"
    echo "         keyboard on the VNC screen: WASD/arrows=dpad j=A k=B u/x=X i=Y"
    echo "         q/e=L1/R1 z/c=L2/R2 Enter=Start Bksp=Select F1/F2=tabs"
    (cmd_audio start) || echo "  (audio could not start — retry: knulli-vm audio start)"
}

cmd_stop() {
    cmd_audio stop
    # feeds are opt-in, but leaving audiocap + a guest aplay holding a
    # loopback substream after the app dies is the orphan class that has
    # faked "silent app" before — sweep them with the app.
    # SAY WHICH ONES. A feed that vanishes without a word is indistinguishable
    # from a broken capture path: "microphone recording does not work at all"
    # turned out to be an app restart that had swept the feed, and nothing on
    # screen said so. Auto-relaunching on `start` is deliberately NOT the fix —
    # a 'system' feed re-captures the guest's own output (feedback), and macOS
    # capture permissions are a human decision — so report and let the user
    # decide.
    local swept
    swept=$(cmd_feed status 2>/dev/null | awk -F': ' '/: running/ {gsub(/^ +/, "", $1); printf "%s ", $1}')
    cmd_feed stop all >/dev/null 2>&1 || true
    [ -n "$swept" ] && echo "  feeds stopped with the app (${swept% }) — bring them back with: knulli-vm feed mic  /  knulli-vm feed usb"
    # Kill the WHOLE tree, not just the wrapper pid: the app UI, its
    # audio-pump child and aplay survive a wrapper-only kill as ppid=1
    # orphans that keep hogging X, an aloop substream and CPU — and an
    # orphan once made the live app's audio uncapturable (see
    # audio_capture.sh). sudo: the tree runs as root inside the chroot.
    # The sweep patterns are bracketed so they cannot match this very
    # ssh command line.
    # SIGTERM is NOT enough: the app installs signal handlers and survives
    # it (observed — orphaned UI kept serving a respawned aplay), so every
    # kill here is TERM, grace, then -9.
    gexec 'p=$(cat /tmp/knulli-app.pid 2>/dev/null); rm -f /tmp/knulli-app.pid || sudo rm -f /tmp/knulli-app.pid
        killtree() { for c in $(pgrep -P "$1" 2>/dev/null); do killtree "$c"; done; sudo kill "$1" 2>/dev/null; }
        [ -n "$p" ] && killtree "$p"
        sleep 1
        killtree() { for c in $(pgrep -P "$1" 2>/dev/null); do killtree "$c"; done; sudo kill -9 "$1" 2>/dev/null; }
        [ -n "$p" ] && killtree "$p"
        sudo pkill -f "gb_launch[.]py" 2>/dev/null
        sudo pkill -x aplay 2>/dev/null
        sleep 1
        sudo pkill -9 -f "gb_launch[.]py" 2>/dev/null
        sudo pkill -9 -x aplay 2>/dev/null
        echo stopped'
}

cmd_status() {
    limactl list | grep -E "NAME|$VM[[:space:]]" | head -2
    gexec '
        printf "  joypad:  "; pgrep -f "virtual_joypad[.]py" >/dev/null && echo up || echo down
        printf "  display: "; { pgrep -x Xvnc >/dev/null || pgrep -x Xvfb >/dev/null; } && echo ":1 up" || echo down
        printf "  vnc:     "; if pgrep -x Xvnc >/dev/null; then echo "Xvnc up on port '"${VNC_PORT:-5901}"'"; elif pgrep -x x11vnc >/dev/null; then echo "x11vnc up on port '"${VNC_PORT:-5901}"'"; else echo down; fi
        printf "  keymap:  "; pgrep -f "keymapd[.]py" >/dev/null && echo "keyboard->pad up" || echo "DOWN (knulli-vm keymap restart)"
        # ps -p, NOT kill -0: the tracked pid setuids to root via sudo inside
    # the chroot, and kill -0 from the guest user gives EPERM on a live
    # root process — status then cries "not running" while the app plays.
    printf "  app:     "; p=$(cat /tmp/knulli-app.pid 2>/dev/null); [ -n "$p" ] && ps -p "$p" -o pid= >/dev/null 2>&1 && echo "running (pid $p)" || echo not running'
    printf "  audio:   "; audio_running >/dev/null && echo "streaming to Mac (pid $(cat "$AUDIO_PIDF"))" || echo "not streaming"
    (cmd_feed status) | sed 's/^  feed /  feed   /'
    echo "  apps:"; (cmd_app list) | sed 's/^/    /'
}

# Xvnc binds the GUEST loopback (-localhost yes). Lima >= 2.1 (vz)
# auto-forwards guest listeners to host localhost — older Lima does not,
# and "VNC won't connect" then has nothing to do with the app. If the
# guest is listening but the host is not, open an ssh tunnel ourselves.
VNC_TUNNEL_PIDF="$STATE/vnc.$VM.pid"

# Is the Mac-side listener on $1 actually OURS? Lima forwards each VM's guest
# 5901 to the Mac's 5901 and only ONE install can win that port; the loser's
# forward never binds, so a plain "is something listening on 5901" probe says
# yes while the window that opens is the OTHER VM's screen (two installs on
# one Mac, or Screen Sharing already on 5901). lima's hostagent cmdline names
# its own instance dir, which identifies whose forward this is.
port_is_ours() {
    local port="$1" pid tp
    tp=$(cat "$VNC_TUNNEL_PIDF" 2>/dev/null)
    for pid in $(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null); do
        [ -n "$tp" ] && [ "$pid" = "$tp" ] && return 0
        ps -p "$pid" -o command= 2>/dev/null | grep -q "/\.lima/$VM/" && return 0
    done
    return 1
}

cmd_vnc() {
    local port="${VNC_PORT:-5901}"
    if gexec "ss -ltn | grep -q \":$port \"" 2>/dev/null; then
        if ! nc -z 127.0.0.1 "$port" 2>/dev/null; then
            local tp; tp=$(cat "$VNC_TUNNEL_PIDF" 2>/dev/null)
            if [ -z "$tp" ] || ! kill -0 "$tp" 2>/dev/null; then
                echo "lima does not forward guest :$port — starting ssh tunnel ..."
                nohup ssh -F "$HOME/.lima/$VM/ssh.config" "lima-$VM" \
                    -nNT -o ExitOnForwardFailure=yes -L "$port:localhost:$port" \
                    >/dev/null 2>&1 &
                echo $! > "$VNC_TUNNEL_PIDF"
                sleep 1
            fi
        elif ! port_is_ours "$port"; then
            # the port answers — just not for us. Saying "connect here" would
            # send the user to a different machine's framebuffer.
            local who; who=$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | head -1)
            echo "WARNING: Mac port $port is forwarded by something OTHER than VM '$VM'"
            echo "         (pid ${who:-?}: $(ps -p "${who:-0}" -o command= 2>/dev/null | cut -c1-70))"
            echo "         vnc://localhost:$port shows that display, not this one."
            echo "         move this install: ./install.sh --vm-name $VM --vnc-port <free port>"
            return
        fi
    else
        echo "note: nothing is listening on guest :$port — start the app first (knulli-vm start)"
    fi
    echo "vnc://localhost:$port  (password: ${VNC_PASS:-knulli})"
}

# The VNC keyboard -> pad mapper (keymapd.py). If keys stop mapping on the
# VNC screen, restart it here and read its per-key log.
cmd_keymap() {
    case "${1:-status}" in
        restart)
            # the ( ... & ) subshell detaches from the ssh session; a plain
            # trailing & dies with it when limactl's ssh tears down the pgid
            # $ anchor: the real process cmdline ends with keymapd.py, while
            # this very bash -lc string contains both "keymapd[.]py" and the
            # launch path — an unanchored pattern makes pkill kill its own
            # ssh session (exit 255, keymapd never restarts)
            gexec 'sudo pkill -f "keymapd[.]py$" 2>/dev/null; sleep 0.5
                   mkdir -p ~/knulli-vm-logs
                   (sudo DISPLAY=:1 setsid nohup python3 ~/knulli-vm/keymapd.py >~/knulli-vm-logs/keymap.log 2>&1 </dev/null &)
                   sleep 1.5
                   pgrep -f "keymapd[.]py" >/dev/null && echo "keymapd restarted" || { echo "FAILED to start keymapd:"; tail -5 ~/knulli-vm-logs/keymap.log; }';;
        log) gexec 'tail -40 ~/knulli-vm-logs/keymap.log 2>/dev/null || tail -40 /tmp/keymap.log';;
        status) gexec 'pgrep -f "keymapd[.]py" >/dev/null && echo "keymapd up (VNC keyboard maps to the pad)" || echo "keymapd DOWN — run: knulli-vm keymap restart"';;
        *) die "keymap: restart|log|status";;
    esac
}

cmd_input() {
    [ -n "${1:-}" ] || die "input: give a FIFO command, e.g. knulli-vm input 'hat down 150'"
    gexec "printf '%s\n' '$1' | sudo tee /tmp/joypad.fifo >/dev/null" && echo "sent: $1"
}

cmd_screenshot() {
    local out="${1:-knulli-vm-shot.png}"
    gexec "DISPLAY=:1 import -window root /tmp/knv-shot.png" && \
    gexec "cat /tmp/knv-shot.png" > "$out" && echo "wrote $out"
}

# ---- audio -----------------------------------------------------------------
# The guest has no sound hardware; the chroot's ALSA default is routed into a
# snd-aloop loopback card (lib/guest/setup_audio.sh) and we capture the other
# end over ssh into a tiny CoreAudio player on the Mac.
AUDIO_PIDF="$STATE/audio.$VM.pid"
AUDIO_BIN="$HERE/bin/audioplay"
AUDIO_SH="$STATE/audio.$VM.sh"
# The two long-lived pipelines (this one and the feeds) live in a GENERATED host
# script rather than inside a `nohup bash -c "..."` string, because that string is
# parsed by a second shell and eats one layer of quoting. Measured, the string
# form shipped the guest `bash -lc sudo /path/audio_capture.sh ...` — quotes
# already consumed — which the guest read as "run sudo with no command": two pages
# of sudo usage in the capture log, audioplay at EOF, the Mac silent, and
# `audio status` saying "not streaming" with no error anywhere a user would look.
# A file is parsed once, and `cat state/<vm>.audio.sh` shows what really runs.
# gremote — one command, quoted for the GUEST shell, to sit inside a generated
# host script. ssh joins its arguments with spaces and lets the guest re-parse
# the result, so quoting that one shell has already consumed is worth nothing:
# writing `bash -lc %q` into a file leaves `bash -lc sudo\ /path/foo`, the file's
# own parse eats that backslash, and the guest receives `bash -lc sudo /path/foo`
# = "run sudo with no command" (two pages of sudo usage, a silent Mac, and no
# error anywhere a user would look). The double quotes here are what survive:
# inside them the escapes stay literal, reach ssh intact, and are parsed GUEST-side.
gremote() { printf 'bash -lc "%s"' "$(printf '%q' "$1")"; }

audio_running() {
    local p; p=$(cat "$AUDIO_PIDF" 2>/dev/null) || return 1
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

killtree() {  # kill $1 and all descendants (bash -> limactl/ssh -> audioplay)
    local p=$1 c
    for c in $(pgrep -P "$p" 2>/dev/null); do killtree "$c"; done
    kill "$p" 2>/dev/null
}

cmd_audio() {
    case "${1:-start}" in
        start)
            if audio_running; then echo "audio: already streaming (pid $(cat "$AUDIO_PIDF"))"; return; fi
            # rebuild on staleness, not just absence (see install.sh note)
            if [ ! -x "$AUDIO_BIN" ] || \
               [ "$HERE/lib/host/audioplay.swift" -nt "$AUDIO_BIN" ]; then
                echo "building host audio player (swiftc) ..."
                mkdir -p "$HERE/bin"
                xcrun swiftc -O -o "$AUDIO_BIN" "$HERE/lib/host/audioplay.swift" \
                    || die "audioplay build failed (need xcrun swiftc: xcode-select --install)"
            fi
            # audio_capture.sh (guest, as root) holds the capture end of EVERY
            # output substream on the loopback card and sums them, so there is
            # nothing to discover and nothing to re-select mid-note. It used to
            # read one cable, because the chroot's default mixed all clients onto
            # one substream through dmix — and that mixer was the "enormous delay
            # that will not clear": dmix will not mix past its slowest client, and
            # the app holds one stream it never writes to, which pinned the mix
            # for 35 hours (setup_audio.sh has the measurement). Wiring every sub
            # keeps the property the mixer was bought for — static, never hunting
            # for the audio mid-note, never wired to silence while the audio plays
            # elsewhere — without sharing a position anyone can stall.
            # The reader's own -B/-F (20 ms / 5 ms, in audio_capture.sh) are
            # latency, not slack: that stream is already clocked at 48 kHz, so
            # whatever this buffer holds is simply delivered late. The other half
            # of the same number is the WRITER's buffer — aplay's own 500 ms
            # default, capped by brick_aplay.sh. Both measurements are written up
            # in setup_audio.sh.
            # stderr is appended to a log, never discarded: a pipe that cannot
            # open its cable otherwise fails as silence.
            # bash -lc on the guest so ~ expands THERE (the exec form spawns no
            # guest shell; host-side $HOME would leak in)
            gtransport
            cat > "$AUDIO_SH" <<EOF
#!/bin/bash
# generated by knulli-vm audio start — safe to edit by hand to experiment; 'audio
# stop' and 'audio start' rewrite it. Guest stderr lands in this log: a pipe that
# cannot open its cable otherwise fails as silence. (No backticks in here: an
# unquoted heredoc runs them.)
exec 2>>"$STATE/$VM.audio.log"
$GTRANSPORT $(gremote 'sudo ~/knulli-vm/audio_capture.sh') | "$AUDIO_BIN" 48000 2
EOF
            chmod +x "$AUDIO_SH"
            # </dev/null: without it the pipe inherits the terminal's stdin and
            # keeps it open for its whole life, so `audio start` never really
            # detaches (it looks hung in any caller that waits for its children).
            nohup "$AUDIO_SH" </dev/null >/dev/null 2>&1 &
            echo $! > "$AUDIO_PIDF"
            echo "audio: guest loopback -> Mac speakers (pid $!, log $STATE/$VM.audio.log)"
            # THE INPUTS COME UP WITH THE OUTPUT, and stay up. Neither fake capture
            # device has hardware behind it, so an input that is only wired when
            # someone remembers to wire it is an input that records exact zeros —
            # and the app re-opens a fresh capture stream for every take and flips
            # freely between BUILT-IN MIC and USB AUDIO (both read out of the
            # binary), so "wired at the moment the user pressed record" is exactly
            # the guarantee a one-shot feed cannot give. audio_feed.sh's supervisor
            # holds the wire and follows the sub; this brings it up.
            # GB_FEEDS="mic" trims the list, GB_FEEDS=off skips it: the USB feed
            # taps the Mac's OWN audio, which needs an awake display (see cmd_feed)
            # and re-hears the guest's output playing on this Mac.
            local f
            for f in ${GB_FEEDS:-mic usb}; do
                case "$f" in mic|usb) ;; *) echo "  (GB_FEEDS: ignoring '$f', use mic|usb|off)"; continue;; esac
                feed_running "$f" && { echo "  feed $f: already wired"; continue; }
                (cmd_feed "$f") || echo "  (feed $f could not start — knulli-vm feed $f)"
            done
            ;;
        stop)
            if audio_running; then killtree "$(cat "$AUDIO_PIDF")"; fi
            rm -f "$AUDIO_PIDF"
            # bracket trick: the pattern must not match this very ssh cmdline.
            # Kill the mixer BEFORE its arecords — the mixer respawns a held
            # cable's reader, so a reader killed first just comes back. The
            # patterns match by ARGUMENT ORDER on purpose: the reader's arecords
            # start "-f S16_LE -r 48000", while the app's own recording takes open
            # "-D hw:0,0" first, so stopping our pipe cannot interrupt a take.
            # The .py pattern only clears a follower left over from before the
            # cables were fixed; it respawned its own arecord, so it had to die too.
            gexec 'sudo pkill -f "audio_capture[.]py" 2>/dev/null; sudo pkill -f "python3 -u - [0-9]" 2>/dev/null; sleep 0.3; sudo pkill -f "ar[e]cord -f S16_LE -r 48000" 2>/dev/null; true'
            ;;
        status)
            audio_running && echo "streaming (pid $(cat "$AUDIO_PIDF"))" || echo "not streaming";;
        *) die "audio: start|stop|status";;
    esac
}

# ---- host audio -> guest capture (the app's USB input and built-in mic) ------
# The input mirror of cmd_audio. The VM now fakes the two capture devices
# GrainBrick records from (setup_audio.sh builds the cards, asound_overlay.sh
# describes the USB one to the app); neither has hardware, so audiocap reads
# the Mac's OWN audio — the microphone (AVAudioEngine) or what the Mac is
# playing (ScreenCaptureKit) — and the bytes travel down the same ssh-pipe
# style as the playback path into audio_feed.sh, which writes the cross-device
# loopback cable the app's arecord is holding. No host USB device is ever
# passed through: the app's "USB AUDIO" input is the host's audio, by design.
#
#   knulli-vm feed usb            Mac system audio -> app's USB source
#   knulli-vm feed mic            Mac microphone   -> app's BUILT-IN MIC
#   knulli-vm feed usb|mic --source mic|system [--secs N]
#   knulli-vm feed stop [usb|mic|all]  |  knulli-vm feed status
FEED_BIN="$HERE/bin/audiocap"
feed_pidf() { echo "$STATE/feed.$VM.$1.pid"; }
feed_logf() { echo "$STATE/feed.$VM.$1.log"; }
feed_running() {
    local p; p=$(cat "$(feed_pidf "$1")" 2>/dev/null) || return 1
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

cmd_feed() {
    local what="${1:-status}"; shift || true
    case "$what" in
        usb|mic)
            local target="$what" source="" secs=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --source) source="$2"; shift 2;;
                    --secs)   secs="$2"; shift 2;;
                    *) die "feed $target: unknown flag $1";;
                esac
            done
            # The defaults ARE the feature: the app's USB input hears the
            # Mac's audio, the app's mic hears the Mac's microphone.
            [ -n "$source" ] || { [ "$target" = usb ] && source=system || source=mic; }
            case "$source" in mic|system) ;; *) die "feed: --source must be mic or system";; esac
            if feed_running "$target"; then
                echo "feed $target: already running (pid $(cat "$(feed_pidf "$target")")) — knulli-vm feed stop $target first"
                return
            fi
            if [ ! -x "$FEED_BIN" ] || [ "$HERE/lib/host/audiocap.swift" -nt "$FEED_BIN" ]; then
                echo "building host audio capture (swiftc) ..."
                mkdir -p "$HERE/bin"
                xcrun swiftc -O -o "$FEED_BIN" "$HERE/lib/host/audiocap.swift" \
                    || die "audiocap build failed (need xcrun swiftc: xcode-select --install)"
            fi
            gexec "test -f ~/knulli-vm/audio_feed.sh" \
                || die "guest feed injector missing — run: knulli-vm sync"

            # Size the host encoder from the app's ACTUAL capture stream
            # before any byte flows: the loopback ends share one ring buffer,
            # so a rate/channel mismatch is a pitch shift, not an error.
            # "-" = nothing recording yet; feed the app's preset format to
            # sub 0 and skip the injector's wait (nothing to discover yet —
            # and audiocap's queue only holds 0.75 s, so waiting blind just
            # drops the head of the feed).
            local probe rate ch psub
            probe=$(gexec "~/knulli-vm/audio_feed.sh $target --probe 2>/dev/null")
            read -r rate ch psub <<< "$probe"
            case "$rate" in ''|*[!0-9]*) rate=48000;; esac
            case "$ch"  in ''|*[!0-9]*) ch=$([ "$target" = usb ] && echo 2 || echo 1);; esac
            # The sub the probe found is printed for the human and deliberately NOT
            # handed on as --sub. A pinned sub turns audio_feed.sh's follower off
            # (and blocks its loop), and the app opens a NEW capture stream for
            # every take, flipping between mic and USB in the same session: a pinned
            # feed then keeps writing the sub the first take used while the app
            # records a different one — exact silence, reported as "running". That
            # is the whole "mic works, USB does not" class. Nothing here decides
            # where the app's next take lands; the supervisor follows it.

            # Re-amp warning: 'system' captures EVERYTHING the Mac plays —
            # including audioplay rendering the guest's own output, so the app
            # would hear itself. Excluding it is not possible from this side.
            if [ "$source" = system ] && audio_running; then
                echo "feed $target: NOTE — 'system' also re-captures the guest's own audio playing on this Mac (feedback possible); --source mic avoids it"
            fi

            local logf; logf="$(feed_logf "$target")"
            # A `system` feed dies with the display: ScreenCaptureKit taps system
            # audio THROUGH an active display, so the moment the monitor naps the
            # stream stops with -3815 "Failed to find any displays" — measured
            # twice today, and the whole reason "mic works but usb input does not"
            # on a Mac whose display sleeps. Hold a display assertion for exactly
            # as long as the feed lives: it is a child of this wrapper, so
            # `feed stop`'s killtree takes it down with the pipeline and nothing
            # keeps the screen awake once the feed is gone.
            local caf=""
            if [ "$source" = system ]; then
                # WAKE in the outer script and wait there; HOLD inside the wrapper.
                # Both halves were learned by breaking them:
                #  * `caffeinate -d` prevents display sleep but does NOT wake a
                #    napped display; `-u -t N` does (measured 0 -> 1 active).
                #  * the wake lands ~2.5 s after caffeinate starts, on a Mac whose
                #    display re-sleeps seconds after the assertion goes away.
                #  * the wait must NOT be inside the wrapper: the health check
                #    below looks for the audiocap child ONE second after launch, so
                #    a wrapper that sleeps first reported every feed as "the Mac
                #    capture is not running" and killed it — awake display or not.
                caffeinate -u -t 10 >/dev/null 2>&1 &
                sleep 3.5
                # -t 86400 is a formality: this caffeinate is a child of the
                # wrapper, so `feed stop`'s killtree ends it with the feed and
                # nothing keeps the screen on afterwards.
                caf='caffeinate -d -t 86400 & CAF=$!; trap '"'"'kill $CAF 2>/dev/null'"'"' EXIT; '
                echo "feed $target: keeping the display awake while this feed runs (caffeinate -d)"
            fi
            # The whole pipeline in one nohup'd script: audiocap's stdout IS the
            # ssh stdin. Killing this pid (killtree) closes the pipe; the
            # guest's aplay then sees EOF and exits, so no orphan holds the
            # loopback (the ghost class that once faked "silent app" for hours).
            # Generated as a file, not a `bash -c` string — see AUDIO_SH.
            gtransport
            local fsh="$STATE/feed.$VM.$target.sh"
            cat > "$fsh" <<EOF
#!/bin/bash
# generated by knulli-vm feed $target — rewritten on every start. This is the
# file to read when a feed is silent: it shows the exact command, and the log it
# appends its own stderr to below.
exec 2>>"$logf"
$caf# The Mac's capturer is the fragile half of this wire. ScreenCaptureKit exits
# with -3805 "application connection being interrupted" when the display it is
# tapping goes away, and a feed that dies quietly is indistinguishable from a
# broken app — which is precisely what it was reported as. So the pair is
# restarted, not mourned. The guest supervisor exits as soon as its stdin closes
# (audio_feed.sh), so every attempt starts both halves clean.
n=0
while :; do
    # \$n stays literal: the generating shell runs under set -u, so an
    # unescaped arithmetic expansion of it here is an "unbound variable" abort in
    # the MIDDLE of the heredoc — which leaves a truncated (0-byte) wrapper behind
    # and every feed thereafter "fails" with no command in it at all. (And no
    # backticks anywhere in here: an unquoted heredoc RUNS them.)
    [ \$((++n)) -gt 1 ] && echo "feed $target: the Mac capture ended, restarting (attempt \$n)"
    "$FEED_BIN" '$source' '$rate' '$ch' ${secs:+--secs '$secs'} | $GTRANSPORT $(gremote "sudo ~/knulli-vm/audio_feed.sh $target --wait 0")
    [ -n '$secs' ] && break
    sleep 1
done
EOF
            chmod +x "$fsh"
            nohup "$fsh" </dev/null >/dev/null 2>&1 &
            local pid=$!
            echo "$pid" > "$(feed_pidf "$target")"
            # Permission failures (Microphone / Screen Recording) and a missing
            # ACTIVE DISPLAY kill the capturer in its first second with the fix
            # spelled out — and the wrapper pid proves nothing about that. The
            # pipeline is `bash -c 'audiocap | ssh … audio_feed.sh'`, and when
            # audiocap dies instantly the guest half keeps running through its
            # whole discovery wait, so `kill -0 $pid` is true and `feed` cheerfully
            # reported a feed writing nothing. That is precisely how "USB input
            # records only silence" looked healthy. Require the CAPTURER to be
            # alive as a child of the pipe, not just the pipe itself.
            sleep 1
            if ! kill -0 "$pid" 2>/dev/null || ! pgrep -P "$pid" -x audiocap >/dev/null 2>&1; then
                echo "feed $target: the Mac capture is not running — nothing will be recorded:"
                sed 's/^/  /' "$logf" 2>/dev/null | tail -12
                # Do not leave the guest injector parked on the cable, holding the
                # substream and writing silence that looks like a broken app.
                killtree "$pid" 2>/dev/null
                gexec "sudo pkill -f 'audio_feed[.]sh $target' 2>/dev/null; sudo pkill -f 'aplay -D hw:$([ "$target" = usb ] && echo USBAudio || echo Codec),1,' 2>/dev/null; true"
                rm -f "$(feed_pidf "$target")"
                # Only claim PERMISSION when the log actually says permission: a
                # no-active-display failure prints the right remedy already, and a
                # "go grant Screen Recording" line under it sends the user to fix
                # something that is not broken.
                if grep -qi 'screen recording' "$logf" 2>/dev/null; then
                    echo "  (System Settings > Privacy & Security > Screen Recording — enable your TERMINAL app, then relaunch it)"
                elif [ "$source" = mic ]; then
                    echo "  (Microphone: System Settings > Privacy & Security > Microphone — enable your TERMINAL app)"
                    echo "  (no input device at all: System Settings > Sound > Input)"
                fi
                exit 1
            fi
            echo "feed $target: Mac $source -> $target (${rate}Hz/${ch}ch, wired permanently, follows the app's capture sub${psub:+ — on $psub now}, pid $pid)"
            echo "  log: $logf   stop: knulli-vm feed stop $target"
            ;;
        stop)
            local list t
            case "${1:-all}" in
                all) list="usb mic";;
                usb|mic) list="$1";;
                *) die "feed stop: usb | mic | all";;
            esac
            for t in $list; do
                feed_running "$t" && killtree "$(cat "$(feed_pidf "$t")")"
                # keep the log: "the feed died mid-take" is exactly when it matters
                rm -f "$(feed_pidf "$t")"
                # belt and braces: an aplay orphaned by a killed ssh still
                # holds the cable; the bracket trick keeps pkill from
                # matching this very command line.
                local card; card=$([ "$t" = usb ] && echo USBAudio || echo Codec)
                gexec "sudo pkill -f 'audio_feed[.]sh $t' 2>/dev/null; sudo pkill -f 'aplay -D hw:$card,1,' 2>/dev/null; true"
            done
            echo "feed: stopped"
            ;;
        status)
            local t
            for t in usb mic; do
                printf "  feed %-4s " "$t:"
                feed_running "$t" \
                    && echo "running (pid $(cat "$(feed_pidf "$t")"), $(head -c 200 "$(feed_logf "$t")" 2>/dev/null | grep -o 'source=[^ ]*' | head -1))" \
                    || echo "not running"
            done;;
        *) die "feed: usb|mic [--source mic|system] [--secs N] | stop [usb|mic|all] | status";;
    esac
}

cmd_bridge() {
    local vdir="$HERE/padenv"
    if [ ! -x "$vdir/bin/python" ]; then
        echo "creating padenv (host venv for gamepad reading) ..."
        python3 -m venv "$vdir" && "$vdir/bin/pip" install -q --only-binary :all: pygame-ce \
            || die "padenv setup failed (need python3 with pygame-ce wheels)"
    fi
    "$vdir/bin/python" "$HERE/lib/host/pad_bridge.py" "$VM"
}

cmd_sync() {
    gexec "mkdir -p ~/knulli-vm"
    # directory-driven, same policy as install.sh: ship everything in
    # lib/guest/, fail on the first bad copy
    for f in "$HERE"/lib/guest/*; do
        gexec "install -m 755 /dev/stdin ~/knulli-vm/$(basename "$f")" < "$f" \
            || die "failed to deploy lib/guest/$(basename "$f")"
    done
    echo "guest scripts synced"
}

cmd_up() {
    if limactl list | grep -q "^$VM[[:space:]].*Running"; then
        echo "VM '$VM' already running"; return 0
    fi
    echo "starting VM '$VM' ..."
    limactl start "$VM" >/dev/null 2>&1 || die "limactl start failed for '$VM'"
    # "Running" only means the hypervisor is alive — cloud-init can still
    # hold ssh at "Connection refused" for tens of seconds (same trap as
    # install.sh step 1). Don't report up until a command lands.
    local t=0
    # Re-decide the transport on every pass: the ssh.config this CLI would use is
    # written by limactl during start, so the first probes may have to be limactl's.
    GTRANSPORT=""
    until gexec true 2>/dev/null; do
        sleep 2; t=$((t + 2)); GTRANSPORT=""
        [ "$t" -ge 120 ] && die "VM '$VM' booted but ssh never answered (ssh lima-$VM / limactl shell $VM)"
    done
    echo "VM '$VM' up"
}

cmd_down() {
    local force="${1:-}"
    case "$force" in
        -f|--force)
            # Hard stop: SIGKILL the hypervisor, no guest shutdown — the
            # escape hatch when the guest is wedged and limactl stop hangs.
            echo "force-stopping VM '$VM' (no guest shutdown) ..."
            limactl stop -f "$VM" || die "limactl stop -f failed"
            echo "VM '$VM' killed — start again: knulli-vm up"
            return;;
        "") ;;
        *) die "down: --force for a hard stop";;
    esac
    # Best effort, never blocking: if the guest ssh is already dead the
    # point is moot and limactl stop must still run.
    cmd_stop >/dev/null 2>&1 || true
    echo "stopping VM '$VM' (graceful) ..."
    limactl stop "$VM" || die "limactl stop failed — try: knulli-vm down --force"
    echo "VM '$VM' stopped — start again: knulli-vm up"
}

# ---- dispatch ----------------------------------------------------------------
case "${1:-help}" in
    start) shift; cmd_start "$@";;
    stop) cmd_stop;;
    up) cmd_up;;
    down) shift; cmd_down "${1:-}";;
    status) cmd_status;;
    vnc) cmd_vnc;;
    keymap) shift; cmd_keymap "${1:-status}";;
    input) shift; cmd_input "$*";;
    screenshot|shot) shift; cmd_screenshot "$@";;
    bridge) cmd_bridge;;
    audio) shift; cmd_audio "$@";;
    feed) shift; cmd_feed "$@";;
    app) shift; cmd_app "$@";;
    sync) cmd_sync;;
    help|--help|-h)
        cat <<'EOF'
knulli-vm — run apps inside extracted KNULLI userspace in a Lima VM

  knulli-vm up                   start the VM itself (knulli-vm start assumes it runs)
  knulli-vm start [app]         start services + app (default app if omitted)
  knulli-vm stop                stop the app
  knulli-vm down [--force]      shut the VM down (stops app+audio first;
                                --force = hard kill, for a wedged guest)
  knulli-vm status              VM / services / app / installed apps
  knulli-vm vnc                 VNC URL + password
  knulli-vm screenshot [file]   grab the VM display
  knulli-vm input "CMD"         gamepad FIFO: press|hold|release BUTTON,
                                hat DIR [ms] (incl. diagonals), holdhat
                                DIR|none, axis lx|ly V
                                BUTTON: A B X Y L1 R1 L2 R2 SELECT START
                                MODE TAB- TAB+ (aliases: F1/F2, SOUTH/EAST/
                                NORTH/WEST/TL/TR/TL2/TR2 for host pads)
                                (on the VNC screen the keyboard itself maps:
                                WASD/arrows=dpad, j=A k=B u/x=X i=Y,
                                q/e=L1/R1, z/c=L2/R2, Enter=Start,
                                BackSpace=Select, m=MENU, F1/F2=tabs)
  knulli-vm audio start|stop    pipe guest audio to the Mac (auto by start)
  knulli-vm feed usb|mic        host audio -> the app's capture devices
                                usb  = the app's USB AUDIO input  (Mac's audio)
                                mic  = the app's BUILT-IN MIC     (Mac's mic)
                                [--source mic|system] [--secs N]
                                stop [usb|mic|all] | status
                                (macOS prompts for Microphone / Screen
                                Recording the first time; grant to the
                                TERMINAL running knulli-vm)
  knulli-vm keymap restart      VNC keyboard mapper: restart|status|log
                                (if WASD/arrows stop mapping on the VNC
                                screen, this fixes it in one second)
  knulli-vm bridge              feed a physical USB/BT pad (plugged into Mac)
  knulli-vm app add SRC [--name N] [--cmd C] [--default]
